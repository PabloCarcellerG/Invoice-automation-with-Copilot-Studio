{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:invoice-accelerator:local-demo:invoice:1.0",
  "title": "LOCAL DEMO positive EUR full-PO no-tax invoice",
  "description": "Synthetic reference contract only. The engine additionally verifies scoped caller/config, exact dynamic evidence paths, confidence, calendar date, buyer, PO/receipt quantities, exact Decimal totals and approval authority. Source hashes/evidence are illustrative metadata, not source-authenticity verification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "customer_id", "legal_entity_id", "source", "invoice", "evidence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "customer_id": {"$ref": "#/$defs/identifier"},
    "legal_entity_id": {"$ref": "#/$defs/identifier"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "event_id", "reference", "sha256"],
      "properties": {
        "transport": {"$ref": "#/$defs/identifier"},
        "event_id": {"$ref": "#/$defs/identifier"},
        "reference": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "invoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supplier_id", "buyer_id", "invoice_number", "invoice_series", "document_type", "currency", "invoice_date", "purchase_order_id", "tax_treatment", "tax_amount", "subtotal_amount", "total_amount", "lines"],
      "properties": {
        "supplier_id": {"$ref": "#/$defs/identifier"},
        "buyer_id": {"$ref": "#/$defs/identifier"},
        "invoice_number": {"$ref": "#/$defs/identifier"},
        "invoice_series": {"anyOf": [{"const": ""}, {"$ref": "#/$defs/identifier"}]},
        "document_type": {"const": "PO_INVOICE"},
        "currency": {"const": "EUR"},
        "invoice_date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "purchase_order_id": {"$ref": "#/$defs/identifier"},
        "tax_treatment": {"const": "NO_TAX"},
        "tax_amount": {"const": "0.00"},
        "subtotal_amount": {"$ref": "#/$defs/positiveMoney"},
        "total_amount": {"$ref": "#/$defs/positiveMoney"},
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["line_number", "quantity", "unit_price", "line_amount"],
            "properties": {
              "line_number": {"$ref": "#/$defs/identifier"},
              "quantity": {"$ref": "#/$defs/positiveQuantity"},
              "unit_price": {"$ref": "#/$defs/positiveMoney"},
              "line_amount": {"$ref": "#/$defs/positiveMoney"}
            }
          }
        }
      }
    },
    "evidence": {
      "description": "Engine requires exactly these base fields plus all four paths for EVERY actual zero-based line index; paths for nonexistent lines are rejected.",
      "type": "object",
      "additionalProperties": false,
      "required": ["/invoice/supplier_id", "/invoice/buyer_id", "/invoice/invoice_number", "/invoice/invoice_series", "/invoice/document_type", "/invoice/currency", "/invoice/invoice_date", "/invoice/purchase_order_id", "/invoice/tax_treatment", "/invoice/tax_amount", "/invoice/subtotal_amount", "/invoice/total_amount", "/invoice/lines/0/line_number", "/invoice/lines/0/quantity", "/invoice/lines/0/unit_price", "/invoice/lines/0/line_amount"],
      "properties": {
        "/invoice/supplier_id": {"$ref": "#/$defs/evidence"},
        "/invoice/buyer_id": {"$ref": "#/$defs/evidence"},
        "/invoice/invoice_number": {"$ref": "#/$defs/evidence"},
        "/invoice/invoice_series": {"$ref": "#/$defs/evidence"},
        "/invoice/document_type": {"$ref": "#/$defs/evidence"},
        "/invoice/currency": {"$ref": "#/$defs/evidence"},
        "/invoice/invoice_date": {"$ref": "#/$defs/evidence"},
        "/invoice/purchase_order_id": {"$ref": "#/$defs/evidence"},
        "/invoice/tax_treatment": {"$ref": "#/$defs/evidence"},
        "/invoice/tax_amount": {"$ref": "#/$defs/evidence"},
        "/invoice/subtotal_amount": {"$ref": "#/$defs/evidence"},
        "/invoice/total_amount": {"$ref": "#/$defs/evidence"}
      },
      "patternProperties": {
        "^/invoice/lines/(?:[0-9]|[1-4][0-9])/(?:line_number|quantity|unit_price|line_amount)$": {"$ref": "#/$defs/evidence"}
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?$"
    },
    "positiveMoney": {
      "type": "string",
      "pattern": "^(?!0\\.00$)(?:0|[1-9][0-9]{0,9})\\.[0-9]{2}$"
    },
    "positiveQuantity": {
      "type": "string",
      "pattern": "^(?!0(?:\\.0{1,3})?$)(?:0|[1-9][0-9]{0,5})(?:\\.[0-9]{1,3})?$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "page", "source_span"],
      "properties": {
        "confidence": {"type": "string", "pattern": "^(?:0(?:\\.[0-9]{1,4})?|1(?:\\.0{1,4})?)$"},
        "page": {"type": "integer", "minimum": 1, "maximum": 10000},
        "source_span": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?$"}
      }
    }
  }
}
